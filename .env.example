# Copia este archivo como .env y llena los valores que te entregó el profe.

# --- Modelo (vía LiteLLM Proxy, compatible con la API de OpenAI) ---
LLM_BASE_URL=https://proxy-del-taller.ejemplo.com
LLM_API_KEY=sk-llave-de-tu-equipo
LLM_MODEL=modelo-taller

# --- LangSmith (trazas) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_tu_llave
LANGSMITH_PROJECT=liga-equipo-01

# --- Solo para el profesor (app de Biblio) ---
BIBLIO_ADMIN_PASSWORD=cambia-esto
BIBLIO_TEMPERATURA=0.3
